<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" >
<FontFamily x:Key="FontUI">Microsoft YaHei UI</FontFamily><FontFamily x:Key="FontIcons">Segoe MDL2 Assets</FontFamily><sys:Double x:Key="FontDisplay">36</sys:Double>
<sys:Double x:Key="FontPageTitle">28</sys:Double>
<sys:Double x:Key="FontSection">18</sys:Double>
<sys:Double x:Key="FontCardTitle">16</sys:Double>
<sys:Double x:Key="FontBody">14</sys:Double>
<sys:Double x:Key="FontSecondary">13</sys:Double>
<sys:Double x:Key="FontCaption">12</sys:Double>
<sys:Double x:Key="FontMicro">11</sys:Double>

<Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundDeepBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontFamily" Value="{StaticResource FontUI}"/><Setter Property="FontSize" Value="{StaticResource FontBody}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
<Style TargetType="UserControl"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontFamily" Value="{StaticResource FontUI}"/><Setter Property="FontSize" Value="{StaticResource FontBody}"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="{StaticResource FontBody}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypeDisplay" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontDisplay}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypePageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontPageTitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypeSection" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSection}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypeCardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontCardTitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypeBody" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontBody}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
<Style x:Key="TypeSecondary" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSecondary}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/></Style>
<Style x:Key="TypeCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontCaption}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/></Style>
<Style x:Key="TypeMicro" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontMicro}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></Style>
<Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TypePageTitle}"/>
<Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TypeSection}"/>
<Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource TypeCaption}"/>
<Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource TypeCaption}"/>
<Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TypeSecondary}"/>
<Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource TypeDisplay}"/>
<Style x:Key="NavGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource TypeMicro}"><Setter Property="Margin" Value="{StaticResource NavGroupMargin}"/></Style>
<Style x:Key="IssueMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IssueCount}" Value="0"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></DataTrigger></Style.Triggers></Style>
</ResourceDictionary>
