<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#07101C</Color>
    <Color x:Key="BackgroundDeepColor">#040A13</Color>
    <Color x:Key="SidebarColor">#081321</Color>
    <Color x:Key="SurfaceColor">#0E1B2B</Color>
    <Color x:Key="SurfaceRaisedColor">#13243A</Color>
    <Color x:Key="SurfaceHoverColor">#192E49</Color>
    <Color x:Key="BorderColor">#233852</Color>
    <Color x:Key="BorderStrongColor">#315174</Color>
    <Color x:Key="PrimaryColor">#668EFF</Color>
    <Color x:Key="PrimaryHoverColor">#82A4FF</Color>
    <Color x:Key="AccentColor">#43D7C4</Color>
    <Color x:Key="SuccessColor">#43D7A8</Color>
    <Color x:Key="WarningColor">#F3B65B</Color>
    <Color x:Key="DangerColor">#F27078</Color>
    <Color x:Key="TextPrimaryColor">#F3F7FC</Color>
    <Color x:Key="TextSecondaryColor">#A9B9CD</Color>
    <Color x:Key="TextMutedColor">#70849E</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundDeepBrush" Color="{StaticResource BackgroundDeepColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryBrightBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="#253E7A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1A2B" Offset="0"/><GradientStop Color="#071525" Offset="0.55"/><GradientStop Color="#050D18" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7398FF" Offset="0"/><GradientStop Color="#526FE8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D41B3156" Offset="0"/><GradientStop Color="#C510233A" Offset="0.56"/><GradientStop Color="#C20A1B2A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackgroundImageOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9A040A13" Offset="0"/><GradientStop Color="#59040A13" Offset="0.56"/><GradientStop Color="#8C040A13" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LoginImageOverlayBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D807101C" Offset="0"/><GradientStop Color="#A807101C" Offset="0.7"/><GradientStop Color="#3D07101C" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#385FA8FF" Offset="0"/><GradientStop Color="#00668EFF" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
