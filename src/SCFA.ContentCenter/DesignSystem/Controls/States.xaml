<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCFA.ContentCenter.DesignSystem">
<ui:StateLabelConverter x:Key="StateLabelConverter"/><ui:MessageStateConverter x:Key="MessageStateConverter"/><ui:DashboardStateConverter x:Key="DashboardStateConverter"/><ui:HealthStateConverter x:Key="HealthStateConverter"/>
<Style x:Key="SemanticText" TargetType="TextBlock" BasedOn="{StaticResource TypeCaption}"><Style.Triggers><Trigger Property="ui:Tone.State" Value="Success"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="PartialFailure"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Loading"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Syncing"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Info"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Offline"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></Trigger><Trigger Property="ui:Tone.State" Value="Disabled"><Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/></Trigger></Style.Triggers></Style>
<Style TargetType="{x:Type ui:StateNotice}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:StateNotice}">
  <Border x:Name="NoticeSurface" Background="{StaticResource NeutralTintBrush}" CornerRadius="{StaticResource RadiusM}" Padding="{StaticResource Inset16}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="ToneRail" Width="{StaticResource AccentRailWidth}" Background="{StaticResource TextMutedBrush}" Margin="{StaticResource GapRight16}"/>
    <StackPanel Grid.Column="1"><TextBlock x:Name="ToneLabel" Style="{StaticResource TypeCaption}" Text="{Binding State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource StateLabelConverter}}"/>
     <TextBlock Style="{StaticResource TypeSecondary}" Text="{TemplateBinding Message}" Margin="{StaticResource GapAbove4}"/>
    </StackPanel>
   </Grid>
  </Border><ControlTemplate.Triggers><Trigger Property="State" Value="Success"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource SuccessBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource SuccessBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource SuccessTintBrush}"/></Trigger><Trigger Property="State" Value="Error"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource DangerBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource DangerTintBrush}"/></Trigger><Trigger Property="State" Value="Warning"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource WarningBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource WarningTintBrush}"/></Trigger><Trigger Property="State" Value="PartialFailure"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource WarningBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource WarningTintBrush}"/></Trigger><Trigger Property="State" Value="Loading"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource CyanTintBrush}"/></Trigger><Trigger Property="State" Value="Syncing"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource CyanTintBrush}"/></Trigger><Trigger Property="State" Value="Info"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource CyanTintBrush}"/></Trigger><Trigger Property="State" Value="Offline"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource TextMutedBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource NeutralTintBrush}"/></Trigger><Trigger Property="State" Value="Disabled"><Setter TargetName="ToneRail" Property="Background" Value="{StaticResource TextDisabledBrush}"/><Setter TargetName="ToneLabel" Property="Foreground" Value="{StaticResource TextDisabledBrush}"/><Setter TargetName="NoticeSurface" Property="Background" Value="{StaticResource NeutralTintBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
