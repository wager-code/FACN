<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCFA.ContentCenter.DesignSystem">

<!-- Primary surfaces are opt-in. Secondary content uses alignment, spacing, and dividers. -->
<Style x:Key="CardBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/><Setter Property="CornerRadius" Value="{StaticResource RadiusL}"/><Setter Property="Padding" Value="{StaticResource CardPadding}"/></Style>
<Style x:Key="RaisedCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}"><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
<Style x:Key="ToolbarBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}"><Setter Property="Padding" Value="{StaticResource ToolbarPadding}"/><Setter Property="Background" Value="{StaticResource NeutralTintBrush}"/><Setter Property="CornerRadius" Value="{StaticResource RadiusM}"/></Style>
<Style x:Key="InsetBorder" TargetType="Border"><Setter Property="Padding" Value="{StaticResource CompactPadding}"/><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/></Style>
<Style x:Key="PillBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource NeutralTintBrush}"/><Setter Property="Padding" Value="{StaticResource RowPadding}"/><Setter Property="CornerRadius" Value="{StaticResource RadiusXS}"/></Style>
<Style x:Key="StatusBadgeBorder" TargetType="Border" BasedOn="{StaticResource PillBorder}"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style x:Key="WorkflowStepBorder" TargetType="Border" BasedOn="{StaticResource InsetBorder}"/>
<Style x:Key="PreviewFrame" TargetType="Border" BasedOn="{StaticResource InsetBorder}"><Setter Property="Background" Value="{StaticResource BackgroundDeepBrush}"/><Setter Property="ClipToBounds" Value="True"/></Style>
<Style x:Key="Divider" TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/><Setter Property="BorderThickness" Value="{StaticResource BorderBottom}"/><Setter Property="Margin" Value="{StaticResource GapBelow24}"/></Style>
<Style x:Key="DialogSurface" TargetType="Border" BasedOn="{StaticResource RaisedCardBorder}"><Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/><Setter Property="CornerRadius" Value="{StaticResource RadiusXL}"/><Setter Property="ui:Motion.Enter" Value="Modal"/></Style>
<Style x:Key="FeatureIcon" TargetType="Border"><Setter Property="Width" Value="{StaticResource IconSizeLarge}"/><Setter Property="Height" Value="{StaticResource IconSizeLarge}"/><Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Margin" Value="{StaticResource GapRight16}"/></Style>

</ResourceDictionary>
