<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NavIcon" TargetType="Border"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Style>
    <Style x:Key="NavRadioButton" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="10,2"/><Setter Property="Padding" Value="13,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="GroupName" Value="PrimaryNavigation"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Border x:Name="NavBackground" Background="{TemplateBinding Background}" CornerRadius="8"/><Border x:Name="ActiveRail" Width="3" Height="20" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="0,3,3,0" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#1A3151"/><Setter TargetName="ActiveRail" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
