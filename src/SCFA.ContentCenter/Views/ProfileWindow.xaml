<Window x:Class="SCFA.ContentCenter.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑个人资料" Width="560" Height="570" MinWidth="560" MinHeight="570"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Border Background="{StaticResource BackgroundDeepBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="个人资料" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="头像、昵称与联系方式仅保存在这台电脑" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowControlButton}" Content="×" Click="CancelButton_Click" ToolTip="关闭"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,20">
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource PrimaryMutedBrush}">
                                <Image x:Name="AvatarPreview" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="本机头像" FontWeight="SemiBold"/>
                                <TextBlock Text="PNG 或 JPEG，最大 5 MB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChooseAvatarButton" Style="{StaticResource CompactButton}" Content="选择图片" Click="ChooseAvatarButton_Click"/>
                                    <Button x:Name="RemoveAvatarButton" Style="{StaticResource CompactButton}" Content="移除头像" Click="RemoveAvatarButton_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="显示名称" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DisplayNameBox" MaxLength="40" Height="42"/>
                    <TextBlock Text="留空时显示账号原有名称" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,15"/>

                    <TextBlock Text="QQ（可选）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="QQBox" MaxLength="20" Height="42"/>
                    <TextBlock Text="手机号（可选）" FontWeight="SemiBold" Margin="0,15,0,6"/>
                    <TextBox x:Name="PhoneBox" MaxLength="30" Height="42"/>
                    <TextBlock Text="联系方式只用于本机资料展示，不会上传到服务器。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="CancelButton_Click" Width="88" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存资料" Click="SaveButton_Click" Width="108" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
