<UserControl x:Class="SCFA.ContentCenter.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="系统检查" Style="{StaticResource EyebrowText}"/><TextBlock Text="诊断中心" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/><TextBlock Text="检查软件、游戏目录和连接状态，帮助定位常见问题。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0"><CheckBox Content="检查在线服务" IsChecked="{Binding IncludeNetwork}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Style="{StaticResource SecondaryButton}" Content="查看运行记录" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="导出诊断信息" Command="{Binding ExportCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Content="重新检查" Command="{Binding RunCommand}"/></WrapPanel></Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource InsetBorder}" Margin="0,0,5,0"><StackPanel><TextBlock Text="检查项目" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource InsetBorder}" Margin="5,0"><StackPanel><TextBlock Text="正常" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding PassedCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border><Border Style="{StaticResource InsetBorder}" Margin="5,0"><StackPanel><TextBlock Text="需处理" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ProblemCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border><Border Style="{StaticResource InsetBorder}" Margin="5,0,0,0"><StackPanel><TextBlock Text="检查范围" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding NetworkModeLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding LastRun}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Style="{StaticResource PillBorder}" Margin="12,0,0,0"><TextBlock Text="{Binding HealthLabel}"/></Border></Grid></Border>
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True"><DataGrid ItemsSource="{Binding Items}" AlternationCount="2" RowHeight="44" ColumnHeaderHeight="38"><DataGrid.Columns><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="检查项" Binding="{Binding Check}" Width="190"/><DataGridTemplateColumn Header="状态" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="HealthBadge" Style="{StaticResource StatusBadgeBorder}" Background="#43292C" BorderBrush="#734149"><TextBlock x:Name="HealthText" Text="需处理" Foreground="#FFC4C8" FontSize="11"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Passed}" Value="True"><Setter TargetName="HealthBadge" Property="Background" Value="#173A38"/><Setter TargetName="HealthBadge" Property="BorderBrush" Value="#27645D"/><Setter TargetName="HealthText" Property="Text" Value="正常"/><Setter TargetName="HealthText" Property="Foreground" Value="#A8E9DF"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="诊断详情" Binding="{Binding Detail}" Width="*" MinWidth="320"/></DataGrid.Columns></DataGrid></Border>
    </Grid>
</UserControl>
