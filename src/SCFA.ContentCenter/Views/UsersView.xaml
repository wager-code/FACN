<UserControl x:Class="SCFA.ContentCenter.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="账号与权限" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="用户与会话管理" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="管理服务器真实账号、角色、状态和活动会话；所有写入操作继续要求二次确认。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Top" Margin="16,4,0,0">
                <TextBlock Text="{Binding AccessLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="用户总数" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="服务器真实账号" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="正常账号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ActiveCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="当前可正常登录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="受限账号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding RestrictedCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="停用或暂停" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="14"><StackPanel><TextBlock Text="活动会话" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SessionCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="当前登录会话" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索用户名、邮箱、角色或状态"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Border Style="{StaticResource StatusBadgeBorder}" Margin="12,0,0,0"><TextBlock Text="{Binding VisibleCount, StringFormat={}{0} 条可见}"/></Border>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="刷新用户" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="用户目录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="选择用户后在右侧执行受控操作" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="250" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="用户" Width="*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Email}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="角色" Binding="{Binding RoleDisplay, Mode=OneWay}" Width="105"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding ActiveSessions, Mode=OneWay}" Width="54"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="所选账号" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedUserLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedUserMetadata}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="账号 ID" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.Id, TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.Id}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="权限明细" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedPermissionSummary}"/></StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,17,7,0">
                        <TextBlock Text="角色" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRole}"/>
                        <TextBlock Text="账号状态" Style="{StaticResource FieldLabel}" Margin="0,13,0,4"/>
                        <ComboBox ItemsSource="{Binding UserStatuses}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}"/>
                        <Border Style="{StaticResource InsetBorder}" Margin="0,14,0,0" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="活动会话" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.ActiveSessions, TargetNullValue=—}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="创建时间" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.CreatedAtDisplay, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="上次登录" Style="{StaticResource FieldLabel}" Margin="0,13,0,4"/>
                        <TextBlock Text="{Binding SelectedItem.LastLoginAtDisplay, TargetNullValue=—}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="保存角色与状态" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource DangerButton}" Content="撤销全部活动会话" Command="{Binding RevokeSessionsCommand}" Margin="0,9,0,0"/>
                        <TextBlock Text="写操作会显示二次确认，不会静默执行。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,9,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
