<UserControl x:Class="SCFA.ContentCenter.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="REVIEW QUEUE" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="投稿审核" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="检查玩家内容、元数据与校验信息；所有审核决定继续受 submissions.review 权限保护。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding PermissionLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
                <Button Style="{StaticResource SecondaryButton}" Content="刷新队列" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="待审核" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding QueueCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="真实服务器队列" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="地图" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding MapCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="地图投稿" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="MOD" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ModCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="模组投稿" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="14"><StackPanel><TextBlock Text="队列容量" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TotalSizeText}" Style="{StaticResource MetricValue}"/><TextBlock Text="待检查安装包" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,11">
                        <StackPanel><TextBlock Text="审核队列" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="按提交时间从新到旧显示" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" MaxWidth="300"/></Border>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="提交时间" Binding="{Binding CreatedAt}" Width="145"/>
                            <DataGridTextColumn Header="投稿人" Binding="{Binding Submitter}" Width="105"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="62"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="75"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="82"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="REVIEW DECISION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedMetadata}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                        <StackPanel Margin="0,0,7,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="作者" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.Author, TargetNullValue=—}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="分类" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.Category, TargetNullValue=—}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="文件 / 大小" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedPackage}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="内容 ID" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.ContentId, TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.ContentId}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="标签" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.TagsText, TargetNullValue=—}" TextWrapping="Wrap"/>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,12,0,0" Padding="12" MinHeight="88">
                                <StackPanel><TextBlock Text="内容说明" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedItem.Description, TargetNullValue=选择投稿后查看内容说明。}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Text="包 SHA-256" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.Sha256, TargetNullValue=—}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="内容 SHA-256" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.ContentSha256, TargetNullValue=—}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <DockPanel><TextBlock Text="审核意见" Style="{StaticResource FieldLabel}"/><TextBlock DockPanel.Dock="Right" Text="{Binding ReviewMessageCount, StringFormat={}{0} 字}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></DockPanel>
                        <TextBox Text="{Binding ReviewMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" MaxHeight="100" ToolTip="拒绝时建议填写明确原因"/>
                        <Grid Margin="0,10,0,0">
                            <Button Style="{StaticResource DangerButton}" Content="拒绝投稿" Command="{Binding RejectCommand}" HorizontalAlignment="Left"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="审核通过" Command="{Binding ApproveCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
