<UserControl x:Class="SCFA.ContentCenter.Views.CloudContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0">
                <Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="目录 "/><TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" Foreground="White"/></StackPanel></Border>
                <Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="已安装 "/><TextBlock Text="{Binding InstalledCount}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="待处理 "/><TextBlock Text="{Binding AttentionCount}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel>
                    <Grid Width="286" Margin="0,0,9,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,11,8" ToolTip="搜索名称、ID、版本、目录、作者、说明、分类、标签或别名"/>
                        <Border Width="17" Height="17" Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"><Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/search_regular.png"/></Border.OpacityMask></Border>
                    </Grid>
                    <ComboBox Width="132" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Margin="0,0,9,8" ToolTip="安装状态"/>
                    <ComboBox Width="126" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" Margin="0,0,9,8" ToolTip="内容分类"/>
                    <ComboBox Width="132" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}" Margin="0,0,9,8" ToolTip="排序方式"/>
                    <ComboBox Width="122" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding LibraryFilter}" Margin="0,0,0,8" ToolTip="内容库范围"/>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="14,0,0,0">
                        <Button Style="{StaticResource CompactButton}" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,7,0"/>
                        <Button Style="{StaticResource CompactButton}" Content="勾选当前筛选" Command="{Binding SelectVisibleCommand}" Margin="0,0,7,0"/>
                        <Button Style="{StaticResource CompactButton}" Content="清除勾选" Command="{Binding ClearSelectionCommand}" Margin="0,0,7,0"/>
                        <Button Style="{StaticResource CompactButton}" Content="取消批量" Command="{Binding CancelBatchCommand}"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AlternationCount="2" RowHeight="42" ColumnHeaderHeight="38" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="收藏" Width="52">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock x:Name="FavoriteMark" Text="☆" FontSize="17" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/><DataTemplate.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="FavoriteMark" Property="Text" Value="★"/><Setter TargetName="FavoriteMark" Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="同步偏好" Width="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="SkipButton" Content="{Binding SyncSkipButtonText}" ToolTip="{Binding SyncSkipTooltip}"
                                            Command="{Binding DataContext.ToggleSyncSkipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Padding="6,3" MinHeight="28" HorizontalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSyncExcluded}" Value="True"><Setter Property="Foreground" Value="#FFB9C5"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="2*" MinWidth="180"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding VersionDisplay, Mode=OneWay}" Width="150"/>
                        <DataGridTemplateColumn Header="本地状态" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StateBadge" Background="#172A40" BorderBrush="#29415D" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="168">
                                        <TextBlock x:Name="StateText" Text="{Binding InstallState, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="current"><Setter TargetName="StateBadge" Property="Background" Value="#173A38"/><Setter TargetName="StateBadge" Property="BorderBrush" Value="#27645D"/><Setter TargetName="StateText" Property="Foreground" Value="#A8E9DF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="newer"><Setter TargetName="StateBadge" Property="Background" Value="#1D334D"/><Setter TargetName="StateText" Property="Foreground" Value="#BBD4F5"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="missing"><Setter TargetName="StateBadge" Property="Background" Value="#332D21"/><Setter TargetName="StateBadge" Property="BorderBrush" Value="#675235"/><Setter TargetName="StateText" Property="Foreground" Value="#F3CE8A"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="update"><Setter TargetName="StateBadge" Property="Background" Value="#263159"/><Setter TargetName="StateBadge" Property="BorderBrush" Value="#485B9A"/><Setter TargetName="StateText" Property="Foreground" Value="#C6D2FF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="repair"><Setter TargetName="StateBadge" Property="Background" Value="#44272D"/><Setter TargetName="StateBadge" Property="BorderBrush" Value="#78404A"/><Setter TargetName="StateText" Property="Foreground" Value="#FFC1C6"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstallStateCode}" Value="conflict"><Setter TargetName="StateBadge" Property="Background" Value="#44272D"/><Setter TargetName="StateText" Property="Foreground" Value="#FFC1C6"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="分类" Binding="{Binding CategoryText, Mode=OneWay}" Width="100"/>
                        <DataGridTextColumn Header="作者" Binding="{Binding AuthorText, Mode=OneWay}" Width="110"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="86"/>
                        <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAt, Mode=OneWay}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="#E607101C">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TotalCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="48" Height="48" Background="{StaticResource TextMutedBrush}" Opacity="0.55"><Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/cloud_regular.png"/></Border.OpacityMask></Border><TextBlock Text="云端目录暂无可显示内容" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/><TextBlock Text="刷新清单或调整当前筛选条件" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="160" Height="96" CornerRadius="9" Background="#0A1727" BorderBrush="#29415D" BorderThickness="1" ClipToBounds="True" Margin="0,0,16,0">
                    <Grid><Image Source="{Binding SelectedItem.PreviewSource}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.HasPreview}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.HasPreview}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Width="28" Height="28" Background="{StaticResource TextMutedBrush}" Opacity="0.7"><Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/cloud_regular.png"/></Border.OpacityMask></Border><TextBlock Text="{Binding SelectedItem.PreviewStateText, TargetNullValue=选择内容查看预览}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="SELECTED CONTENT" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=请选择一项内容, FallbackValue=请选择一项内容}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedItem.DescriptionText, TargetNullValue=从目录中选择内容后查看说明与版本信息, FallbackValue=从目录中选择内容后查看说明与版本信息}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedItem.InstallState}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid Grid.Column="2" Margin="0,1,18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="版本 / 大小" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Column="1"><Run Text="{Binding SelectedItem.VersionDisplay, TargetNullValue=—}"/><Run Text="  ·  "/><Run Text="{Binding SelectedItem.SizeText, TargetNullValue=—}"/></TextBlock>
                    <TextBlock Grid.Row="1" Text="作者 / 分类" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="1" Grid.Column="1"><Run Text="{Binding SelectedItem.AuthorText, TargetNullValue=—}"/><Run Text="  ·  "/><Run Text="{Binding SelectedItem.CategoryText, TargetNullValue=—}"/></TextBlock>
                    <TextBlock Grid.Row="2" Text="安装路径" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.InstallPath, TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.InstallPath}"/>
                    <TextBlock Grid.Row="3" Text="标签" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.TagsText, TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.TagsText}"/>
                </Grid>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="138">
                    <Button Style="{StaticResource PrimaryButton}" Content="安装 / 修复所选" Command="{Binding InstallCommand}" Margin="0,0,0,7"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding FavoriteActionText}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,0,7"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="批量处理勾选项" Command="{Binding InstallSelectedCommand}" Margin="0,0,0,7"/>
                    <Button Style="{StaticResource DangerButton}" Content="下架此内容" Command="{Binding UnpublishCommand}" Visibility="{Binding AdminActionVisibility}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
