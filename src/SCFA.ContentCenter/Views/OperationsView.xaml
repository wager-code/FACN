<UserControl x:Class="SCFA.ContentCenter.Views.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OPERATIONS &amp; AUDIT" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="服务器与审计" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="查看账号 API、投稿、Updater、直连服务健康状态，以及服务器返回的平台审计记录。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding HealthLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
                <Button Style="{StaticResource SecondaryButton}" Content="刷新状态" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="账号 API" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ApiStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="身份与权限服务" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="投稿服务" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SubmissionStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="上传与审核入口" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Updater" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding UpdaterStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdaterStatus}"/><TextBlock Text="客户端发布通道" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="14"><StackPanel><TextBlock Text="直连服务" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding DirectStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectStatus}"/><TextBlock Text="实时连接端点" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索操作者、操作、目标、结果、详情或 IP"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Style="{StaticResource StatusBadgeBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding VisibleAuditCount, StringFormat={}{0} 条可见}"/></Border>
                    <Border Style="{StaticResource StatusBadgeBorder}"><TextBlock Text="{Binding FailedAuditCount, StringFormat={}{0} 条异常}" Foreground="{StaticResource WarningBrush}"/></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="平台审计记录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="仅显示服务器真实返回的数据" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding AuditAccessLabel}"/></Border>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditView}" SelectedItem="{Binding SelectedAudit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="250">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="操作 / 操作者" Width="1.2*" MinWidth="165">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EffectiveActor}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="目标" Binding="{Binding EffectiveTarget}" Width="1.2*" MinWidth="155"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="78"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="AUDIT SELECTION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedAuditTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedAuditMetadata}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="来源 IP" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedAudit.EffectiveIp, TargetNullValue=—}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="记录 ID" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedAudit.Id, TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedAudit.Id}"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,16,0,0" Padding="13">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="审计详情" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedAuditDetail}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Border Style="{StaticResource StatusBadgeBorder}"><TextBlock Text="{Binding AuditAccessLabel}" Foreground="{StaticResource AccentBrush}"/></Border>
                        <TextBlock Text="{Binding LastRefresh, StringFormat=上次刷新：{0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                        <TextBlock Text="客户端不会修改、补写或生成审计数据。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
