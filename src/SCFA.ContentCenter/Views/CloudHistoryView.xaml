<UserControl x:Class="SCFA.ContentCenter.Views.CloudHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERSION ARCHIVE" Style="{StaticResource EyebrowText}"/><TextBlock Text="云端版本历史" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/><TextBlock Text="对比正式版本与服务端历史记录，安装前自动备份本地内容。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom"><Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="正式内容 "/><TextBlock Text="{Binding ContentCount, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="历史记录 "/><TextBlock Text="{Binding VersionCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel></Border></WrapPanel></Grid>
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/><Grid Grid.Column="1" Margin="9,0"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,64,8" ToolTip="按名称、内容 ID、目录或版本搜索"/><Border Width="17" Height="17" Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/search_regular.png"/></Border.OpacityMask></Border><Button Content="清除" Command="{Binding ClearSearchCommand}" Style="{StaticResource CompactButton}" HorizontalAlignment="Right" Margin="0,4,4,4" Padding="8,2"/></Grid><ComboBox Grid.Column="2" ItemsSource="{Binding ContentsView}" SelectedItem="{Binding SelectedContent}" DisplayMemberPath="Name" Margin="0,0,9,0" IsTextSearchEnabled="True"/><Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="刷新内容列表" Command="{Binding RefreshContentsCommand}" Margin="0,0,9,0"/><Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="查询历史版本" Command="{Binding LoadHistoryCommand}"/></Grid><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}"><Run Text="搜索结果 "/><Run Text="{Binding FilteredContentCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ContentCount, Mode=OneWay}"/></TextBlock></Grid></Grid></Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True"><Grid><DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" RowHeight="42" ColumnHeaderHeight="38"><DataGrid.Columns><DataGridTemplateColumn Header="来源" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="HistoryBadge" Style="{StaticResource StatusBadgeBorder}"><TextBlock x:Name="HistoryText" Text="{Binding HistoryState}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding HistoryState}" Value="当前版本"><Setter TargetName="HistoryBadge" Property="Background" Value="#173A38"/><Setter TargetName="HistoryBadge" Property="BorderBrush" Value="#27645D"/><Setter TargetName="HistoryText" Property="Foreground" Value="#A8E9DF"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.8*" MinWidth="180"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="95"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="92"/><DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAt}" Width="170"/><DataGridTextColumn Header="ZIP SHA-256" Binding="{Binding Sha256}" Width="2.2*" MinWidth="220"/></DataGrid.Columns></DataGrid><Border Background="#E607101C"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VersionCount, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="48" Height="48" Background="{StaticResource TextMutedBrush}" Opacity="0.5"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/cloud_regular.png"/></Border.OpacityMask></Border><TextBlock Text="尚未查询历史版本" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/><TextBlock Text="选择内容后点击“查询历史版本”" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="VERSION SELECTION" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding SelectedVersion.Name, TargetNullValue=请选择版本, FallbackValue=请选择版本}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedContentLabel}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedVersionLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/></StackPanel><Grid Grid.Column="1" Margin="0,1,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="版本 / 大小" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Column="1"><Run Text="{Binding SelectedVersion.Version, FallbackValue=—}"/><Run Text=" · "/><Run Text="{Binding SelectedVersion.SizeText, FallbackValue=—}"/></TextBlock><TextBlock Grid.Row="1" Text="发布时间" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.PublishedAt, FallbackValue=—}"/><TextBlock Grid.Row="2" Text="文件" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.File, FallbackValue=—}" TextTrimming="CharacterEllipsis"/></Grid><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="安装所选版本" Command="{Binding InstallCommand}" VerticalAlignment="Center" MinWidth="145"/></Grid></Border>
    </Grid>
</UserControl>
