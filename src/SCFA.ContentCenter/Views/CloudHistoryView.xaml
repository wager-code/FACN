<UserControl x:Class="SCFA.ContentCenter.Views.CloudHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="内容维护" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="内容版本与下架档案" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
                <TextBlock Text="选择内容和版本。恢复前会核验云端 ZIP；玩家只看到正式版本。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="档案 " Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ContentCount}" Margin="0,0,16,0"/>
                <TextBlock Text="已下架 " Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding DownlistedCount}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="125"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" ToolTip="搜索名称、内容 ID 或目录"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ContentsView}" SelectedItem="{Binding SelectedContent}" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" Margin="0,0,8,0"/>
                    <CheckBox Grid.Column="3" Content="只看已下架" IsChecked="{Binding ShowDownlistedOnly}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="刷新档案" Command="{Binding RefreshContentsCommand}"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" RowHeight="42" ColumnHeaderHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding HistoryState}" Width="105"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="1.5*" MinWidth="170"/>
                    <DataGridTextColumn Header="发布版本 / 游戏版本" Binding="{Binding VersionDisplay}" Width="1.2*" MinWidth="130"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                    <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAt}" Width="170"/>
                    <DataGridTextColumn Header="ZIP SHA-256" Binding="{Binding Sha256}" Width="2*" MinWidth="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="版本选择" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="{Binding SelectedContentLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="VersionDisplay" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding SelectedVersionLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="{Binding SelectedVersion.File, FallbackValue=—}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedVersion.PublishedAt, FallbackValue=—}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding SelectedVersion.SizeText, FallbackValue=—}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="恢复为正式版" Command="{Binding RestoreCommand}" MinWidth="145"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="安装到本机" Command="{Binding InstallCommand}" Margin="0,8,0,0" MinWidth="145"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
