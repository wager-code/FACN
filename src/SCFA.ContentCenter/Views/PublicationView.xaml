<UserControl x:Class="SCFA.ContentCenter.Views.PublicationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="ADMIN PUBLICATION" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="管理员发布中心" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
            <TextBlock Text="从本地完整地图或 MOD 准备发布包，核对线上版本并生成待上传清单。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource InsetBorder}" Padding="13" Margin="0,0,0,14">
            <TextBlock Text="当前阶段：生成并校验待上传材料。点击“准备发布材料”不会上传到 COS，也不会改变玩家云端清单。请按生成目录中的《发布步骤》由管理员在 COS 控制台上传。" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="重新扫描" Command="{Binding RefreshCommand}" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" MinHeight="260">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="本地内容" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="查找" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBox Width="155" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏名称、文件夹名、内容 ID 或版本搜索"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedLocal, Mode=TwoWay}" IsReadOnly="True" MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="游戏名称 / 文件夹" Width="*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,3,0,3">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Folder, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version, Mode=OneWay}" Width="55"/>
                            <DataGridTextColumn Header="文件" Binding="{Binding Files, Mode=OneWay}" Width="55"/>
                            <DataGridTemplateColumn Header="校验" Width="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="发布资料" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <TextBlock Text="发布名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                        <TextBlock Text="发布版本" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding ReleaseVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                        <TextBlock Text="游戏内部版本从文件读取，不可在这里修改。发布版本必须高于线上版本。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="作者" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                        <TextBlock Text="分类" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                        <TextBlock Text="标签（逗号分隔，可不填）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" MaxLength="400"/>
                        <TextBlock Text="内容说明" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Height="78" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="准备发布材料" Command="{Binding PrepareCommand}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource InsetBorder}" Padding="12" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="待上传材料目录" FontWeight="SemiBold"/><TextBlock Text="{Binding OutputDirectory, TargetNullValue=尚未生成}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="打开材料目录" Command="{Binding OpenOutputCommand}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
