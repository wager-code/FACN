<UserControl x:Class="SCFA.ContentCenter.Views.SubmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="COMMUNITY SUBMISSION" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="投稿中心" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="从本地内容中制作投稿草稿；正式上传前会再次验证结构并计算双 SHA-256。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><TextBlock><Run Text="可投稿 "/><Run Text="{Binding LocalCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><TextBlock><Run Text="记录 "/><Run Text="{Binding SubmissionCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Style="{StaticResource PillBorder}"><TextBlock><Run Text="资料完整度 "/><Run Text="{Binding DraftCompletion, Mode=OneWay}" FontWeight="Bold"/><Run Text="%"/></TextBlock></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkflowStepBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="01 选择内容" FontWeight="SemiBold"/><TextBlock Text="地图或模组目录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource WorkflowStepBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="02 补全资料" FontWeight="SemiBold"/><TextBlock Text="名称、作者与说明" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource WorkflowStepBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="03 安全校验" FontWeight="SemiBold"/><TextBlock Text="结构与文件哈希" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource WorkflowStepBorder}"><StackPanel><TextBlock Text="04 提交审核" FontWeight="SemiBold"/><TextBlock Text="保留本地投稿记录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="准备投稿">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="本地内容" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="选择或拖入一个内容文件夹" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding LocalCount, StringFormat={}{0} 项}"/></Border>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,13,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Content="选择文件夹" Command="{Binding BrowseContentCommand}" Margin="0,0,8,6"/>
                                <Button Style="{StaticResource CompactButton}" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding LocalItems}" SelectedItem="{Binding SelectedLocal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="62"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="78"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="82"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="3" Style="{StaticResource InsetBorder}" Margin="0,10,0,0" Padding="11">
                                <StackPanel>
                                    <TextBlock Text="当前选择" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding SelectedContentLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="投稿资料" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DraftRequirementHint}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock><Run Text="已完成 "/><Run Text="{Binding DraftCompletedCount, Mode=OneWay}"/><Run Text="/6 项"/></TextBlock></Border>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,5,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="内容版本" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftVersion, Mode=OneWay}" IsReadOnly="True" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="作者" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftAuthor, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="分类" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding DraftCategory}" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="标签" Style="{StaticResource FieldLabel}"/><TextBlock DockPanel.Dock="Right" Text="{Binding TagCount, StringFormat={}{0}/10}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/></DockPanel><TextBox Text="{Binding DraftTags, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,5,0,0" ToolTip="使用逗号分隔，最多 10 个标签"/></StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="内容说明" Style="{StaticResource FieldLabel}"/><TextBlock DockPanel.Dock="Right" Text="{Binding DescriptionCount, StringFormat={}{0}/2000}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/></DockPanel>
                                    <TextBox Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="82" MaxHeight="125" MaxLength="2000" Margin="0,5,0,0"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PreviewFrame}" Width="180" Height="102" HorizontalAlignment="Left"><Image Source="{Binding PreviewSource}" Stretch="Uniform"/></Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="投稿预览图" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PreviewSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                            <WrapPanel><Button Style="{StaticResource CompactButton}" Content="选择图片" Command="{Binding BrowsePreviewCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource CompactButton}" Content="清除" Command="{Binding ClearPreviewCommand}"/></WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,13,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource InsetBorder}" Padding="10"><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="保存草稿" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="删除草稿" Command="{Binding ClearDraftCommand}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Content="取消投稿" Command="{Binding CancelSubmitCommand}" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="校验并投稿" Command="{Binding SubmitCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="我的投稿记录">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="投稿记录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="跟踪本机保存的草稿、上传进度与审核反馈" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding SubmissionCount, StringFormat={}{0} 条记录}"/></Border>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MyItems}" SelectedItem="{Binding SelectedSubmission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="提交时间" Binding="{Binding CreatedAt}" Width="150"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="62"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="82"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95"/>
                            <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="110"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="审核意见" Binding="{Binding ReviewMessage}" Width="2*" MinWidth="190"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSubmission.Name, TargetNullValue=请选择一条投稿记录}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedSubmission.Status, TargetNullValue=等待选择}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedSubmission.Description, TargetNullValue=选择记录后可查看投稿说明。}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedSubmission.TagsText, StringFormat=标签：{0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SelectedSubmission.ReviewMessage, StringFormat=审核意见：{0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
