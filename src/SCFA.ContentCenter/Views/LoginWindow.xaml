<Window x:Class="SCFA.ContentCenter.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SCFA.ContentCenter.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SCFA 内容中心" Width="1040" Height="660" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="LoginBackdropOverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5C020815" Offset="0"/>
            <GradientStop Color="#76030A16" Offset="0.52"/>
            <GradientStop Color="#A5040B15" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LoginCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ED081523" Offset="0"/>
            <GradientStop Color="#E507111E" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="LoginWindowControl" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LoginCloseButton" TargetType="Button" BasedOn="{StaticResource LoginWindowControl}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D94A55"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginFeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#B8254778"/>
            <Setter Property="BorderBrush" Value="#705B8BD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="LoginOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#260A1B2C"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style x:Key="PasswordRevealButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Content" Value="&#xE890;"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RevealBackground" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RevealBackground" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="&#xED1A;"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginLinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrightBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDeepBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Image Source="/SCFA内容中心;component/Assets/command_deck_background.png" Stretch="UniformToFill"/>
            <Border Background="{StaticResource LoginBackdropOverlayBrush}" CornerRadius="11"/>

            <Grid Margin="44,34,44,38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*"/>
                    <ColumnDefinition Width="0.88*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,30,42,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="SCFA CONTENT HUB" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static core:AppVersion.Display}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="内容管理平台" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="战场内容，尽在掌控" FontSize="36" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="同步地图与模组，安全管理版本、备份和玩家投稿。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" LineHeight="24" Margin="0,14,0,24"/>

                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureIcon}">
                                    <Border Width="22" Height="22" Background="{StaticResource TextPrimaryBrush}">
                                        <Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/cloud_regular.png"/></Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="地图与模组快速同步" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="高效稳定地同步玩家内容" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureIcon}">
                                    <Border Width="22" Height="22" Background="{StaticResource TextPrimaryBrush}">
                                        <Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/shield_regular.png"/></Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="安装前备份，内容安全校验" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="自动备份并校验，保障内容安全可靠" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureIcon}">
                                    <Border Width="22" Height="22" Background="{StaticResource TextPrimaryBrush}">
                                        <Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/people_regular.png"/></Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="玩家投稿与版本管理" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="便捷管理玩家投稿与版本发布流程" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Border Width="18" Height="18" Background="{StaticResource SuccessBrush}" Margin="0,0,9,0">
                            <Border.OpacityMask><ImageBrush ImageSource="/SCFA内容中心;component/Assets/Fluent/shield_filled.png"/></Border.OpacityMask>
                        </Border>
                        <TextBlock Text="安全连接 · 本机会话加密" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Margin="12,28,0,4" Padding="32,22,32,16"
                        Background="{StaticResource LoginCardBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel KeyboardNavigation.TabNavigation="Continue">
                            <TextBlock Text="欢迎回来" Foreground="{StaticResource PrimaryBrightBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ModeTitle" Text="登录 SCFA 内容中心" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock x:Name="ModeSubtitle" Text="继续管理地图、模组与投稿内容" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <TextBlock Text="账号或邮箱地址" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                            <ComboBox x:Name="AccountBox" Height="44" FontSize="14" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TabIndex="0"
                                      PreviewKeyDown="AccountBox_PreviewKeyDown" SelectionChanged="AccountBox_SelectionChanged"
                                      ToolTip="可输入新账号，也可以从已保存的账号中选择"/>

                            <StackPanel x:Name="EmailPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock Text="联系邮箱（可选）" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBox x:Name="EmailBox" Height="44" FontSize="14" MaxLength="254" TabIndex="1" PreviewKeyDown="EmailBox_PreviewKeyDown"/>
                            </StackPanel>

                            <TextBlock Text="密码" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,7"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" Height="44" FontSize="14" MaxLength="256" Padding="12,0,48,0" TabIndex="2"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBox x:Name="VisiblePasswordBox" Height="44" FontSize="14" MaxLength="256" Padding="12,0,48,0" TabIndex="2"
                                         Visibility="Collapsed" TextChanged="VisiblePasswordBox_TextChanged"/>
                                <ToggleButton x:Name="PasswordVisibilityButton" Style="{StaticResource PasswordRevealButton}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                              Checked="PasswordVisibilityButton_Changed" Unchecked="PasswordVisibilityButton_Changed"
                                              ToolTip="显示或隐藏密码"/>
                            </Grid>

                            <Grid x:Name="RememberPanel" Margin="0,10,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RememberAccountBox" Content="记住账号" TabIndex="3"
                                          Checked="RememberOption_Changed" Unchecked="RememberOption_Changed"/>
                                <CheckBox x:Name="RememberPasswordBox" Grid.Column="1" Content="记住密码" TabIndex="4"
                                          Checked="RememberOption_Changed" Unchecked="RememberOption_Changed"
                                          ToolTip="密码仅加密保存在这台电脑上"/>
                                <CheckBox x:Name="AutoLoginBox" Grid.Column="2" Content="自动登录" TabIndex="5"
                                          Checked="RememberOption_Changed" Unchecked="RememberOption_Changed"
                                          ToolTip="下次打开软件时自动验证并登录当前账号"/>
                            </Grid>
                            <TextBlock x:Name="RememberHint" Text="可保存多个账号，密码仅加密保存在本机。"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,-1,0,0" TextWrapping="Wrap"/>

                            <Border x:Name="StatusPanel" Background="#D62C231B" BorderBrush="#B365452A" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,12,0,0" MinHeight="38" Visibility="Collapsed">
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource WarningBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </Border>

                            <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}" Content="登录" Margin="0,10,0,0"
                                    Height="44" Click="SubmitButton_Click" IsDefault="True" TabIndex="6"/>
                            <Button x:Name="OfflineButton" Style="{StaticResource LoginOutlineButton}" Content="离线使用" Margin="0,8,0,0"
                                    Click="OfflineButton_Click" TabIndex="7"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="AccountPrompt" Text="还没有账号？" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="SwitchButton" Style="{StaticResource LoginLinkButton}" Content="立即注册"
                                            Click="SwitchButton_Click" TabIndex="8"/>
                                </StackPanel>
                                <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock Text="账号信息仅用于本软件" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       TextAlignment="Center" Margin="8,5,8,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,5,5,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource LoginWindowControl}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="最小化"/>
                <Button Style="{StaticResource LoginWindowControl}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="最大化/还原"/>
                <Button Style="{StaticResource LoginCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
