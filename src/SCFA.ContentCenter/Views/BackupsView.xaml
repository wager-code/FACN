<UserControl x:Class="SCFA.ContentCenter.Views.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="RECOVERY VAULT" Style="{StaticResource EyebrowText}"/><TextBlock Text="历史备份与回滚" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/><TextBlock Text="每次覆盖与恢复前建立真实内容快照，恢复时重新校验并保留当前版本。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0"><Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="备份 "/><TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="地图 "/><TextBlock Text="{Binding MapCount}" Foreground="{StaticResource PrimaryBrightBrush}" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource PillBorder}"><StackPanel Orientation="Horizontal"><TextBlock Text="MOD "/><TextBlock Text="{Binding ModCount}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource PillBorder}"><TextBlock Text="{Binding TotalSizeText}" Foreground="{StaticResource TextSecondaryBrush}"/></Border></WrapPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorder}" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,11,8" ToolTip="按类型、名称、ID、版本或原因筛选"/><Border Width="17" Height="17" Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/search_regular.png"/></Border.OpacityMask></Border></Grid><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="刷新备份" Command="{Binding RefreshCommand}"/></Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid><DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" AlternationCount="2" RowHeight="42" ColumnHeaderHeight="38"><DataGrid.Columns><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="68"/><DataGridTextColumn Header="内容名称" Binding="{Binding Name}" Width="1.7*" MinWidth="180"/><DataGridTextColumn Header="源版本" Binding="{Binding DisplayVersion}" Width="88"/><DataGridTextColumn Header="文件" Binding="{Binding Files}" Width="65"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="88"/><DataGridTextColumn Header="备份原因" Binding="{Binding Reason}" Width="2.2*" MinWidth="210"/></DataGrid.Columns></DataGrid><Border Background="#E607101C"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TotalCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="48" Height="48" Background="{StaticResource TextMutedBrush}" Opacity="0.5"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/history_regular.png"/></Border.OpacityMask></Border><TextBlock Text="尚无内容备份" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/><TextBlock Text="首次安装、覆盖或恢复内容时会自动创建" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel></Border></Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="RECOVERY SELECTION" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=请选择一份备份, FallbackValue=请选择一份备份}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedItem.RevisionRoot, TargetNullValue=选择后可查看快照目录与内容指纹, FallbackValue=选择后可查看快照目录与内容指纹}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.RevisionRoot}"/><TextBlock Text="{Binding SelectedIntegrity}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/></StackPanel><Grid Grid.Column="1" Margin="0,1,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="版本" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.DisplayVersion, FallbackValue=—}"/><TextBlock Grid.Row="1" Text="文件 / 大小" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="1" Grid.Column="1"><Run Text="{Binding SelectedItem.Files, FallbackValue=—}"/><Run Text=" 个 · "/><Run Text="{Binding SelectedItem.SizeText, FallbackValue=—}"/></TextBlock><TextBlock Grid.Row="2" Text="内容指纹" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ContentHash, FallbackValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.ContentHash}"/></Grid><StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="132"><Button Style="{StaticResource PrimaryButton}" Content="恢复此版本" Command="{Binding RestoreCommand}" Margin="0,0,0,7"/><Button Style="{StaticResource SecondaryButton}" Content="打开备份目录" Command="{Binding OpenFolderCommand}" Margin="0,0,0,7"/><Button Style="{StaticResource DangerButton}" Content="永久删除备份" Command="{Binding DeleteCommand}"/></StackPanel></Grid>
        </Border>
    </Grid>
</UserControl>
