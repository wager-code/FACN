<UserControl x:Class="SCFA.ContentCenter.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRANSFER QUEUE" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="下载任务" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
                <TextBlock Text="安装和同步过程中产生的真实任务记录，可取消运行项或重试失败项。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18,0,0,0">
                <TextBlock Text="{Binding QueueStatus}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,7"/>
                <Button Style="{StaticResource SecondaryButton}" Content="清理已结束任务" Command="{Binding ClearFinishedCommand}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource InsetBorder}" Margin="0,0,5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="全部记录" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}"/></StackPanel><Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource TextMutedBrush}" Opacity="0.65"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/document_regular.png"/></Border.OpacityMask></Border></Grid></Border>
            <Border Style="{StaticResource InsetBorder}" Margin="5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="正在处理" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding RunningCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource PrimaryBrightBrush}"/></StackPanel><Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource PrimaryBrightBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/download_regular.png"/></Border.OpacityMask></Border></Grid></Border>
            <Border Style="{StaticResource InsetBorder}" Margin="5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已完成" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CompletedCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/></StackPanel><Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource AccentBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/shield_regular.png"/></Border.OpacityMask></Border></Grid></Border>
            <Border Style="{StaticResource InsetBorder}" Margin="5,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="失败 / 中断" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarningBrush}"/></StackPanel><Border Grid.Column="1" Width="28" Height="28" Background="{StaticResource WarningBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/history_regular.png"/></Border.OpacityMask></Border></Grid></Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" RowHeight="48" ColumnHeaderHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" Width="108"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="78"/>
                        <DataGridTextColumn Header="任务名称" Binding="{Binding Name}" Width="1.6*" MinWidth="170"/>
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="TaskState" Background="#172A40" BorderBrush="#29415D" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="TaskStateText" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="运行中"><Setter TargetName="TaskState" Property="Background" Value="#263159"/><Setter TargetName="TaskState" Property="BorderBrush" Value="#485B9A"/><Setter TargetName="TaskStateText" Property="Foreground" Value="#CAD5FF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="完成"><Setter TargetName="TaskState" Property="Background" Value="#173A38"/><Setter TargetName="TaskState" Property="BorderBrush" Value="#27645D"/><Setter TargetName="TaskStateText" Property="Foreground" Value="#A8E9DF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="失败"><Setter TargetName="TaskState" Property="Background" Value="#44272D"/><Setter TargetName="TaskState" Property="BorderBrush" Value="#78404A"/><Setter TargetName="TaskStateText" Property="Foreground" Value="#FFC1C6"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已中断"><Setter TargetName="TaskState" Property="Background" Value="#332D21"/><Setter TargetName="TaskStateText" Property="Foreground" Value="#F3CE8A"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已取消"><Setter TargetName="TaskState" Property="Background" Value="#2C2C36"/><Setter TargetName="TaskStateText" Property="Foreground" Value="#BFC4D0"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="进度" Width="152">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="3,0"><ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" Margin="0,0,38,0"/><TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="2.2*" MinWidth="200"/>
                        <DataGridTemplateColumn Header="操作" Width="130">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource CompactButton}" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,6,0"/><Button Style="{StaticResource CompactButton}" Content="重试" Command="{Binding RetryCommand}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="#E607101C">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TotalCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="50" Height="50" Background="{StaticResource TextMutedBrush}" Opacity="0.5"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/download_regular.png"/></Border.OpacityMask></Border><TextBlock Text="任务队列为空" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/><TextBlock Text="安装或同步开始后，实时进度会显示在这里" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
