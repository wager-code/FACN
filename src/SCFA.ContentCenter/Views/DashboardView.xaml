<UserControl x:Class="SCFA.ContentCenter.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SCFA.ContentCenter.DesignSystem">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel ui:Motion.Enter="Page">
   <Grid Margin="{StaticResource GapBelow24}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="内容指挥台" Style="{StaticResource PageTitle}"/><TextBlock Text="本地内容与服务状态概览" Style="{StaticResource TypeSecondary}" Margin="{StaticResource GapAbove8}"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Mode}" Style="{StaticResource SemanticText}" ui:Tone.State="{Binding Mode,Converter={StaticResource MessageStateConverter}}"/><TextBlock Text="{Binding LastUpdated}" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove8}"/></StackPanel>
   </Grid>
   <!-- Primary information: one grouped metric surface, no per-metric cards. -->
   <UniformGrid Columns="4" Margin="{StaticResource GapBelow24}">
<StackPanel Margin="{StaticResource MetricPadding}"><TextBlock Text="本地地图" Style="{StaticResource TypeSecondary}"/><TextBlock Text="{Binding MapCount}" Style="{StaticResource MetricValue}" Margin="{StaticResource GapAbove8}"/><TextBlock Text="通过结构校验" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove4}"/></StackPanel>
<StackPanel Margin="{StaticResource MetricPadding}"><TextBlock Text="本地 MOD" Style="{StaticResource TypeSecondary}"/><TextBlock Text="{Binding ModCount}" Style="{StaticResource MetricValue}" Margin="{StaticResource GapAbove8}"/><TextBlock Text="通过结构校验" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove4}"/></StackPanel>
<StackPanel Margin="{StaticResource MetricPadding}"><TextBlock Text="运行中" Style="{StaticResource TypeSecondary}"/><TextBlock Text="{Binding RunningTaskCount}" Style="{StaticResource MetricValue}" Margin="{StaticResource GapAbove8}"/><TextBlock Text="同步与下载任务" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove4}"/></StackPanel>
<StackPanel Margin="{StaticResource MetricPadding}"><TextBlock Text="待处理" Style="{StaticResource TypeSecondary}"/><TextBlock Text="{Binding IssueCount}" Style="{StaticResource IssueMetricValue}" Margin="{StaticResource GapAbove8}"/><TextBlock Text="损坏或不完整内容" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove4}"/></StackPanel>
</UniformGrid>
   <Grid Margin="{StaticResource GapBelow24}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="SyncAction" Style="{StaticResource PrimaryButton}" Content="同步全部内容" Command="{Binding SyncAllCommand}" Margin="{StaticResource GapRight12}"/>
    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="重新扫描" Command="{Binding RefreshCommand}" Margin="{StaticResource GapRight12}"/>
    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="检查服务" Command="{Binding CheckServiceCommand}"/>
   </Grid>
   <ui:StateNotice x:Name="DashboardState" Message="{Binding Status}" Margin="{StaticResource GapBelow32}">
    <ui:StateNotice.State><MultiBinding Converter="{StaticResource DashboardStateConverter}"><Binding Path="Status"/><Binding Path="Mode"/><Binding Path="IssueCount"/><Binding Path="RunningTaskCount"/><Binding Path="MapCount"/><Binding Path="ModCount"/></MultiBinding></ui:StateNotice.State>
   </ui:StateNotice>
   <Border Style="{StaticResource Divider}"/>
   <!-- Secondary information: data lists separated by whitespace and light dividers. -->
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="{StaticResource SectionGapColumn}"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Grid Margin="{StaticResource GapBelow16}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="1" Text="{Binding TaskCount,StringFormat=任务记录 {0}}" Style="{StaticResource TypeCaption}" VerticalAlignment="Center"/></Grid>
     <ItemsControl ItemsSource="{Binding RecentActivities}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="{StaticResource BorderBottom}" Padding="{StaticResource RowPadding}" MinHeight="{StaticResource RowHeightDefault}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TimeText}" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapRight24}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Style="{StaticResource TypeBody}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource TypeCaption}" Margin="{StaticResource GapAbove4}"/></StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Grid Margin="{StaticResource GapBelow16}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="系统健康" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="1" Text="{Binding HealthSummary}" Style="{StaticResource TypeCaption}" VerticalAlignment="Center"/></Grid>
     <ItemsControl ItemsSource="{Binding HealthItems}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="{StaticResource BorderBottom}" Padding="{StaticResource RowPadding}" MinHeight="{StaticResource RowHeightDefault}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="{StaticResource IconSizeDefault}" Height="{StaticResource IconSizeDefault}" Background="{StaticResource TextSecondaryBrush}" Margin="{StaticResource GapRight12}" VerticalAlignment="Center"><Border.OpacityMask><ImageBrush ImageSource="{Binding IconSource}"/></Border.OpacityMask></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource TypeSecondary}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove4}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource SemanticText}" ui:Tone.State="{Binding Status,Converter={StaticResource HealthStateConverter}}" Margin="{StaticResource GapLeft12}" VerticalAlignment="Center"/>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Grid>
   <TextBlock Text="内容操作默认执行校验、覆盖前备份与失败回滚。" Style="{StaticResource TypeMicro}" Margin="{StaticResource GapAbove24}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
