<UserControl x:Class="SCFA.ContentCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="内容指挥台" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="地图、MOD、同步任务与服务状态集中概览" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#183B3A" BorderBrush="#28645D" BorderThickness="1" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Mode}" Foreground="#BDEDE6" FontSize="10"/></StackPanel></Border>
                    <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource HeroGradientBrush}" BorderBrush="#294666" BorderThickness="1" CornerRadius="15" Padding="26" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                <Grid ClipToBounds="True">
                    <Canvas IsHitTestVisible="False"><Ellipse Width="330" Height="330" Fill="{StaticResource GlowBrush}" Canvas.Right="-130" Canvas.Top="-170"/><Rectangle Width="480" Height="1" Fill="#294765" Canvas.Right="-70" Canvas.Top="70" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-18"/></Rectangle.RenderTransform></Rectangle></Canvas>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SCFA CONTENT OPERATIONS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="欢迎回来，战区内容已接入" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0" MaxWidth="610" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SyncAllCommand}" Margin="0,0,10,8"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="同步全部内容"/></StackPanel></Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,8"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="重新扫描"/></StackPanel></Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CheckServiceCommand}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="检查服务"/></StackPanel></Button>
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="28,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="164" Height="164" Fill="#10263E" Stroke="#345778" StrokeThickness="1"/>
                            <Ellipse Width="126" Height="126" Fill="#142F4C" Stroke="#41698F" StrokeThickness="1"/>
                            <Ellipse Width="84" Height="84" Fill="{StaticResource PrimaryMutedBrush}" Stroke="{StaticResource PrimaryBrightBrush}" StrokeThickness="1" Effect="{StaticResource ActionShadow}"/>
                            <Border Width="36" Height="36" Background="White"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/sync_regular.png"/></Border.OpacityMask></Border>
                            <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource PrimaryBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地地图" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding MapCount}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="通过结构校验" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#1D3653" VerticalAlignment="Top"><Border Width="20" Height="20" Background="{StaticResource PrimaryBrightBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/map_regular.png"/></Border.OpacityMask></Border></Border></Grid></Border>
                <Border Style="{StaticResource CardBorder}" Margin="7,0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地 MOD" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ModCount}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="通过结构校验" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#203B49" VerticalAlignment="Top"><Border Width="20" Height="20" Background="{StaticResource AccentBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/box_regular.png"/></Border.OpacityMask></Border></Border></Grid></Border>
                <Border Style="{StaticResource CardBorder}" Margin="7,0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="任务记录" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding TaskCount}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding RunningTaskCount, StringFormat=运行中 {0} 项}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#29334C" VerticalAlignment="Top"><Border Width="20" Height="20" Background="#A9B9FF"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/download_regular.png"/></Border.OpacityMask></Border></Border></Grid></Border>
                <Border Style="{StaticResource CardBorder}" Margin="7,0,0,0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="需要检查" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding IssueCount}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="损坏或不完整内容" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#493827" VerticalAlignment="Top"><Border Width="20" Height="20" Background="{StaticResource WarningBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/shield_regular.png"/></Border.OpacityMask></Border></Border></Grid></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="18"><StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#1B3450"><Border Width="18" Height="18" Background="{StaticResource PrimaryBrightBrush}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/document_regular.png"/></Border.OpacityMask></Border></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="运行状态" Style="{StaticResource SectionTitle}"/><TextBlock Text="最近一次操作和扫描结果" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/></StackPanel></Grid>
                    <Border Background="#0A1726" BorderBrush="#1E344E" BorderThickness="1" CornerRadius="9" Padding="14"><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" TextWrapping="Wrap"/></Border>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel>
                    <TextBlock Text="安全工作流" Style="{StaticResource SectionTitle}"/><TextBlock Text="所有内容操作遵循相同保护链" Style="{StaticResource CaptionText}" Margin="0,3,0,14"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="20" Height="20" CornerRadius="6" Background="#203E47"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border><TextBlock Grid.Column="1" Text="校验清单、版本与内容指纹" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/></Grid>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="20" Height="20" CornerRadius="6" Background="#263B5C"><TextBlock Text="2" Foreground="{StaticResource PrimaryBrightBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border><TextBlock Grid.Column="1" Text="替换前自动创建完整备份" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="20" Height="20" CornerRadius="6" Background="#3F3426"><TextBlock Text="3" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border><TextBlock Grid.Column="1" Text="失败时回滚并保留诊断记录" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/></Grid>
                </StackPanel></Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="18"><StackPanel>
                    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock Text="任务与扫描结果" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TaskCount, StringFormat=记录 {0}}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentActivities}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Top" Margin="0,2,0,0"/><Border Grid.Column="1" Width="9" Height="9" CornerRadius="5" Background="{Binding AccentBrush}" Margin="0,4,0,0" HorizontalAlignment="Left"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34"/></StackPanel></Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel>
                    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="系统健康" Style="{StaticResource SectionTitle}"/><TextBlock Text="本机环境与连接摘要" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding HealthSummary}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
                    <ItemsControl ItemsSource="{Binding HealthItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#0A1726" BorderBrush="#1E344E" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="8" Background="#1D3653"><Border Width="15" Height="15" Background="{Binding StatusBrush}"><Border.OpacityMask><ImageBrush ImageSource="{Binding IconSource}"/></Border.OpacityMask></Border></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><DockPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10"/></DockPanel><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
