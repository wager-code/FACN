<UserControl x:Class="SCFA.ContentCenter.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CONTENT ORCHESTRATION" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="同步中心" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
                <TextBlock Text="补齐缺失、更新旧版本、修复损坏内容，同时保护本地较新版本。" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Bottom" Margin="18,0,0,0" Background="#173A38" BorderBrush="#27645D">
                <StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="安全同步策略已启用" Foreground="#B9EDE6"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource HeroGradientBrush}" BorderBrush="#2A4668" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="选择同步范围" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="全量同步会依次处理地图和 MOD；专项同步只读取对应正式清单。所有覆盖操作都会先保留可恢复备份。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" LineHeight="20"/>
                        <WrapPanel Margin="0,15,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="全部同步" Command="{Binding SyncAllCommand}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="只同步地图" Command="{Binding SyncMapsCommand}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="只同步 MOD" Command="{Binding SyncModsCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#182944" BorderBrush="#355275" BorderThickness="1" CornerRadius="11" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="35" Height="35" Background="{StaticResource PrimaryBrightBrush}" HorizontalAlignment="Left"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/sync_regular.png"/></Border.OpacityMask></Border>
                            <TextBlock Text="同步原则" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,11,0,0"/>
                            <TextBlock Text="不自动降级" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="先校验 · 后备份 · 再替换" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="当前任务" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding RunScope}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrightBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14">
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="9"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="最近状态" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastRun}"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="取消同步" Command="{Binding CancelCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="4,0,4,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="执行记录" Style="{StaticResource SectionTitle}"/><TextBlock Text="逐项显示安装、跳过、修复或失败原因；切换页面或重新打开软件后仍可查看最近记录" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="本次记录 "/><TextBlock Text="{Binding ResultCount}" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="历史记录 "/><TextBlock Text="{Binding HistoryCount}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                        <Button Style="{StaticResource CompactButton}" Content="清除本次" Command="{Binding ClearCurrentCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="清除历史" Command="{Binding ClearHistoryCommand}" Padding="11,6" MinHeight="32"/>
                    </WrapPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Results}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="#E60E1B2B">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ResultCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="42" Height="42" Background="{StaticResource TextMutedBrush}" Opacity="0.5"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/document_regular.png"/></Border.OpacityMask></Border><TextBlock Text="尚无同步记录" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="选择同步范围后，详细结果会显示在这里" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
