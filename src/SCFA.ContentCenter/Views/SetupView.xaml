<UserControl x:Class="SCFA.ContentCenter.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FIRST RUN WORKSPACE" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="首次设置" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="确认 SCFA 安装位置，并准备独立的玩家地图与 MOD 内容空间。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding DetectedCount, StringFormat=检测到 {0} 个游戏目录}"/></Border>
                <Border Style="{StaticResource PillBorder}"><TextBlock Text="{Binding SetupProgress, StringFormat=配置完成度 {0}%}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkflowStepBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="01 发现游戏" FontWeight="SemiBold"/><TextBlock Text="Steam 多库与常见位置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource WorkflowStepBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="02 准备内容目录" FontWeight="SemiBold"/><TextBlock Text="玩家 Maps 与 Mods" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource WorkflowStepBorder}"><StackPanel><TextBlock Text="03 验证并保存" FontWeight="SemiBold"/><TextBlock Text="仅使用已有内容目录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel><TextBlock Text="游戏安装目录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="用于识别游戏，不会在这里安装社区内容" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding GameStateLabel}"/></Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,7,0">
                            <TextBlock Text="SCFA 游戏根目录（可选）" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="应包含 ForgedAlliance.exe 或同类游戏可执行文件"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择目录" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="自动检测结果" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <ComboBox ItemsSource="{Binding DetectedRoots}" SelectedItem="{Binding SelectedDetectedRoot}"/>
                            <TextBlock Text="检测范围包括 Steam 注册表、多库配置和 C-Z 常见安装位置；只接受存在游戏可执行文件的目录。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="重新检测" Command="{Binding DetectCommand}" HorizontalAlignment="Left"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="使用检测结果" Command="{Binding ApplyDetectedCommand}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel><TextBlock Text="玩家内容目录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="地图和 MOD 使用两个互不嵌套的独立目录" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top"><TextBlock Text="{Binding ContentStateLabel}" Foreground="{StaticResource AccentBrush}"/></Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,7,0">
                            <TextBlock Text="Maps 地图目录" Style="{StaticResource FieldLabel}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding MapsDir, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择" Command="{Binding BrowseMapsCommand}" Margin="8,0,0,0"/></Grid>
                            <TextBlock Text="Mods MOD 目录" Style="{StaticResource FieldLabel}" Margin="0,13,0,4"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ModsDir, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择" Command="{Binding BrowseModsCommand}" Margin="8,0,0,0"/></Grid>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,15,0,0" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="安全原则" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="• 不写入游戏安装目录中的原生 Maps/Mods" Margin="0,5,0,0"/>
                                    <TextBlock Text="• 拒绝磁盘根、重解析点及互相嵌套目录" Margin="0,4,0,0"/>
                                    <TextBlock Text="• 只验证已有目录，绝不在 C 盘或猜测位置创建" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="使用游戏目录中现有 maps/mods" Command="{Binding UseDefaultCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ToolbarBorder}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Center"><TextBlock Text="{Binding ReadyLabel}" Foreground="{StaticResource AccentBrush}"/></Border>
                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="验证目录并保存" Command="{Binding CreateAndSaveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
