<UserControl x:Class="SCFA.ContentCenter.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="软件更新管理" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="客户端更新" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="选择更新版本，下载后核对安装包大小、格式和文件完整性；校验通过后才能安装。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillBorder}" Margin="18,4,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ChannelDisplay}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="发布通道" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="按稳定性选择要跟随的版本流" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SecurityStateLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" IsEnabled="{Binding IsChannelSelectionEnabled}" Margin="0,16,0,0" MinWidth="190" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="稳定版"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="beta"><Setter Property="Text" Value="测试版"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="developer"><Setter Property="Text" Value="开发版"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="检查更新" Command="{Binding CheckCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="打开暂存目录" Command="{Binding OpenFolderCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前安装" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="本机正在运行的客户端版本" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                        <StackPanel>
                            <TextBlock Text="通道最新" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding LatestVersionDisplay}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding UpdateStateLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="版本详情" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="检查更新后会在这里显示发布信息与安装状态" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeBorder}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StageStateLabel}"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="发布时间" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Info.PublishedAt, TargetNullValue=—}" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="安装包大小" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Info.SizeText, TargetNullValue=—}" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="安全校验" Style="{StaticResource FieldLabel}"/><TextBlock Text="大小、格式和文件完整性" Margin="0,6,0,0"/></StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,18,0,0" Padding="15" MinHeight="96">
                    <StackPanel>
                        <TextBlock Text="版本说明" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Info.Notes, TargetNullValue=尚未获取版本说明。}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="下载并校验" Command="{Binding DownloadCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="退出并安装" Command="{Binding ApplyCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
