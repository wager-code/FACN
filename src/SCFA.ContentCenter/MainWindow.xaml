<Window x:Class="SCFA.ContentCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SCFA 内容中心" Width="1586" Height="992" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="{StaticResource ShellBorderThickness7}" CornerRadius="{StaticResource RadiusM}" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundDeepBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource ShellBorderThickness1}" CornerRadius="{StaticResource RadiusM}">
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource ShellBorderThickness0_0_1_0}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
                    <Grid Margin="{StaticResource ShellMargin18_16_14_12}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusL}" Background="{StaticResource PrimaryGradientBrush}" Effect="{StaticResource ActionShadow}">
                            <Grid><TextBlock Text="S" FontSize="{StaticResource FontSection}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="7" Height="7" CornerRadius="{StaticResource RadiusXS}" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource ShellMargin0_0_5_5}"/></Grid>
                        </Border>
                        <StackPanel x:Name="BrandTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ShellMargin10_0_0_0}">
                            <TextBlock Text="SCFA 内容中心" FontSize="{StaticResource FontCardTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontMicro}" Margin="{StaticResource ShellMargin0_3_0_0}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource ShellPadding0_4_0_10}">
                        <StackPanel>
                            <RadioButton x:Name="HomeButton" Style="{StaticResource NavRadioButton}" Command="{Binding HomeCommand}" ToolTip="总览">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/home_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="HomeLabel" Grid.Column="1" Text="总览" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="CloudGroupLabel" Text="云端内容" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="CloudMapsButton" Style="{StaticResource NavRadioButton}" Command="{Binding CloudMapsCommand}" ToolTip="云端地图">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/map_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="CloudMapsLabel" Grid.Column="1" Text="云端地图" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="CloudModsButton" Style="{StaticResource NavRadioButton}" Command="{Binding CloudModsCommand}" ToolTip="云端 MOD">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/box_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="CloudModsLabel" Grid.Column="1" Text="云端 MOD" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="LocalGroupLabel" Text="本地与同步" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="LocalMapsButton" Style="{StaticResource NavRadioButton}" Command="{Binding LocalMapsCommand}" ToolTip="本地地图">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/map_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="LocalMapsLabel" Grid.Column="1" Text="本地地图" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="LocalModsButton" Style="{StaticResource NavRadioButton}" Command="{Binding LocalModsCommand}" ToolTip="本地 MOD">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/box_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="LocalModsLabel" Grid.Column="1" Text="本地 MOD" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="SyncButton" Style="{StaticResource NavRadioButton}" Command="{Binding SyncCommand}" ToolTip="同步中心">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/sync_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="SyncLabel" Grid.Column="1" Text="同步中心" VerticalAlignment="Center"/><Border Grid.Column="2" Style="{StaticResource StatusBadgeBorder}" Padding="{StaticResource ShellPadding7_2}" Margin="{StaticResource ShellMargin6_0_0_0}" Visibility="{Binding SyncBadgeVisibility}"><TextBlock Text="{Binding SyncBadgeText}" FontSize="{StaticResource FontMicro}" Foreground="{StaticResource AccentBrush}"/></Border></Grid>
                            </RadioButton>
                            <RadioButton x:Name="DownloadsButton" Style="{StaticResource NavRadioButton}" Command="{Binding DownloadsCommand}" ToolTip="下载任务">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/download_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="DownloadsLabel" Grid.Column="1" Text="下载任务" VerticalAlignment="Center"/><Border Grid.Column="2" Style="{StaticResource StatusBadgeBorder}" Padding="{StaticResource ShellPadding7_2}" Margin="{StaticResource ShellMargin6_0_0_0}" Visibility="{Binding DownloadBadgeVisibility}"><TextBlock Text="{Binding DownloadBadgeText}" FontSize="{StaticResource FontMicro}" Foreground="{StaticResource PrimaryBrightBrush}"/></Border></Grid>
                            </RadioButton>
                            <RadioButton x:Name="BackupsButton" Style="{StaticResource NavRadioButton}" Command="{Binding BackupsCommand}" ToolTip="历史回滚">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/history_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="BackupsLabel" Grid.Column="1" Text="历史回滚" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="PublishGroupLabel" Text="内容发布" Visibility="{Binding PublicationVisibility}" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="PublishMapsButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding PublicationVisibility}" Command="{Binding PublishMapsCommand}" ToolTip="发布地图">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/map_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="PublishMapsLabel" Grid.Column="1" Text="发布地图" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="PublishModsButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding PublicationVisibility}" Command="{Binding PublishModsCommand}" ToolTip="发布 MOD">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/box_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="PublishModsLabel" Grid.Column="1" Text="发布 MOD" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="MaintenanceGroupLabel" Text="内容维护" Visibility="{Binding PublicationVisibility}" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="CloudHistoryButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding PublicationVisibility}" Command="{Binding CloudHistoryCommand}" ToolTip="版本档案">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/history_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="CloudHistoryLabel" Grid.Column="1" Text="版本档案" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="DownlistedButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding PublicationVisibility}" Command="{Binding DownlistedCommand}" ToolTip="已下架内容">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/cloud_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="DownlistedLabel" Grid.Column="1" Text="已下架内容" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="AdminGroupLabel" Text="后台管理" Visibility="{Binding AdminToolsVisibility}" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="UsersButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding AdminToolsVisibility}" Command="{Binding UsersCommand}" ToolTip="用户管理">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/people_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="UsersLabel" Grid.Column="1" Text="用户管理" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="OperationsButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding AdminToolsVisibility}" Command="{Binding OperationsCommand}" ToolTip="服务器审计">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/server_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="OperationsLabel" Grid.Column="1" Text="服务器审计" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="AdminSettingsButton" Style="{StaticResource NavRadioButton}" Visibility="{Binding AdminSettingsVisibility}" Command="{Binding AdminSettingsCommand}" ToolTip="管理员设置">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/settings_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="AdminSettingsLabel" Grid.Column="1" Text="管理员设置" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <TextBlock x:Name="SystemGroupLabel" Text="系统设置" Style="{StaticResource NavGroupTitle}"/>
                            <RadioButton x:Name="DiagnosticsButton" Style="{StaticResource NavRadioButton}" Command="{Binding DiagnosticsCommand}" ToolTip="诊断中心">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/document_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="DiagnosticsLabel" Grid.Column="1" Text="诊断中心" VerticalAlignment="Center"/><Border Grid.Column="2" Width="8" Height="8" CornerRadius="{StaticResource RadiusXS}" Background="{StaticResource WarningBrush}" Margin="{StaticResource ShellMargin8_0_3_0}" Visibility="{Binding DiagnosticBadgeVisibility}"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="UpdatesButton" Style="{StaticResource NavRadioButton}" Command="{Binding UpdatesCommand}" ToolTip="客户端更新">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/download_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="UpdatesLabel" Grid.Column="1" Text="客户端更新" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsButton" Style="{StaticResource NavRadioButton}" Command="{Binding SettingsCommand}" ToolTip="软件设置">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource NavIcon}"><Border.OpacityMask><ImageBrush ImageSource="/Assets/Fluent/settings_regular.png"/></Border.OpacityMask></Border><TextBlock x:Name="SettingsLabel" Grid.Column="1" Text="软件设置" VerticalAlignment="Center"/></Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="UserCard" Grid.Row="2" Margin="{StaticResource ShellMargin12}" Padding="{StaticResource ShellPadding12}" Background="{StaticResource ShellTint0D1D30}" CornerRadius="{StaticResource RadiusM}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource BorderNone}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button x:Name="ProfileButton" Grid.Column="0" Width="40" Height="40" MinHeight="40" Padding="{StaticResource ShellPadding0}" BorderThickness="{StaticResource ShellBorderThickness0}" Background="Transparent" Style="{StaticResource ButtonBaseStyle}" Command="{Binding EditProfileCommand}" ToolTip="编辑个人资料" AutomationProperties.Name="编辑个人资料">
                                <Grid Width="40" Height="40">
                                    <Border CornerRadius="{StaticResource RadiusM}" Background="{StaticResource PrimaryMutedBrush}"/>
                                    <TextBlock Text="{Binding UserInitial}" FontSize="{StaticResource FontBody}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    <Rectangle RadiusX="10" RadiusY="10"><Rectangle.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="UserIdentityPanel" Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource ShellMargin10_0_6_0}"><TextBlock Text="{Binding UserDisplay}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding RoleDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontMicro}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="{StaticResource ShellMargin0_3_0_0}"/></StackPanel>
                            <Button x:Name="LogoutButton" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Content="退出登录" Command="{Binding LogoutCommand}" ToolTip="退出当前账号" Padding="{StaticResource ShellPadding9_0}" Height="{StaticResource IconHitTarget}" MinHeight="{StaticResource IconHitTarget}" Width="{StaticResource LogoutWidth}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource ShellBorderThickness0_0_0_1}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource ShellMargin28_0_0_0}">
                        <Border Width="7" Height="7" CornerRadius="{StaticResource RadiusXS}" Background="{StaticResource AccentBrush}" Margin="{StaticResource ShellMargin0_0_10_0}"/>
                        <StackPanel><TextBlock Text="{Binding CurrentPageTitle}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentPageSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontMicro}" Margin="{StaticResource ShellMargin0_2_0_0}"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="{StaticResource NeutralTintBrush}" CornerRadius="{StaticResource RadiusL}" Padding="{StaticResource ShellPadding10_4}" Margin="{StaticResource ShellMargin0_0_12_0}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Border Width="6" Height="6" CornerRadius="{StaticResource RadiusXS}" Background="{StaticResource SuccessBrush}" Margin="{StaticResource ShellMargin0_0_7_0}" VerticalAlignment="Center"/><TextBlock Text="{Binding WorkspaceDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontMicro}"/></StackPanel></Border>
                        <Button Style="{StaticResource WindowControlButton}" Content="—" Click="MinimizeButton_Click" ToolTip="最小化"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="□" Click="MaximizeButton_Click" ToolTip="最大化/还原"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="×" Click="CloseButton_Click" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" ClipToBounds="True">
                <ContentControl x:Name="ContentHost" Content="{Binding CurrentPage}" Margin="{StaticResource PagePadding}" MaxWidth="{StaticResource ContentMaxWidth}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
