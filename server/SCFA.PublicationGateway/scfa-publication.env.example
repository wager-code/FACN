# Install as /etc/scfa-publication.env, root-owned and readable only by service group.
# Replace placeholders on the server. Never commit the filled file.
SCFA_COS_BUCKET=YOUR-BUCKET-APPID
SCFA_COS_REGION=ap-shanghai
SCFA_COS_ROOT=scfa
SCFA_PUBLICATION_DATA=/var/lib/scfa-publication
SCFA_ACCOUNT_LOCAL_URL=http://127.0.0.1:18080
SCFA_PUBLICATION_MASTER_KEY_B64=GENERATE_RANDOM_32_BYTE_BASE64_ON_SERVER
