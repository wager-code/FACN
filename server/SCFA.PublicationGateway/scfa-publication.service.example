[Unit]
Description=SCFA administrator publication gateway
After=network-online.target scfa-api.service
Wants=network-online.target

[Service]
Type=simple
User=scfa-publication
Group=scfa-publication
WorkingDirectory=/opt/scfa-publication
EnvironmentFile=/etc/scfa-publication.env
ExecStart=/opt/scfa-publication/SCFA.PublicationGateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scfa-publication

[Install]
WantedBy=multi-user.target
